# Porta do servidor (Cloud Run injeta automaticamente a variável PORT)
PORT=8080
HOST=0.0.0.0

# Token que o cliente MCP envia no header "Authorization: Bearer <token>".
# No modo firestore o servidor se recusa a subir com o token padrão ou com menos de 32 caracteres.
# Gere um com: openssl rand -hex 32
AUTH_TOKEN=dev-secret-token

# Modo de Armazenamento: "firestore" (para GCP) ou "sqlite" (para testes locais)
STORAGE_BACKEND=sqlite

# Configurações do GCP Firestore (quando STORAGE_BACKEND=firestore)
GCP_PROJECT_ID=meu-projeto-gcp-pessoal
FIRESTORE_COLLECTION=second_brain_memories
# Máximo de documentos examinados pela busca textual
FIRESTORE_MAX_SCAN=2000
# Só para testes locais com o emulador (gcloud emulators firestore start). Nunca use em produção.
# FIRESTORE_EMULATOR_HOST=localhost:8085

# Termos que nunca podem ir para uma memória (nome da empresa, sistemas internos, clientes), separados por vírgula.
# Em produção ficam no Secret Manager; nunca coloque a lista real neste arquivo de exemplo.
BLOCKED_TERMS=

# Caminho do banco local SQLite (quando STORAGE_BACKEND=sqlite)
SQLITE_DB_PATH=local_storage/memories.db
